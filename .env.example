APP_NAME=ApplyForge Backend
ENV=dev
SECRET_KEY=change-this
ACCESS_TOKEN_EXP_MINUTES=30
REFRESH_TOKEN_EXP_DAYS=14
JWT_ALGORITHM=HS256
# Points at the separately-managed Dokploy "apply-forge-db" MySQL service.
# Use its internal Dokploy hostname (shown on the service's "Domains/Network"
# tab) — this compose stack must be attached to dokploy-network to reach it.
DATABASE_URL=mysql+pymysql://user:password@apply-forge-db-hostname:3306/dbname
CORS_ORIGINS=http://localhost:3000

# Runtime providers (production-safe defaults)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
AI_API_KEY=
OPENAI_BASE_URL=
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5

# Keep false in production. Set true only for local/dev tests where mock providers are required.
AI_ALLOW_MOCK_PROVIDERS=false

# Google OAuth (optional) — enables "Continue with Google" on login/register
# Get these from https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SeaweedFS S3 gateway — runs as the `seaweedfs` service in this compose
# stack with no identity config (anonymous S3 API), so any access/secret
# key pair is accepted. Keep these non-empty so S3StorageService activates.
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=applyforge
S3_SECRET_KEY=applyforge
S3_BUCKET=applyforge-uploads
S3_REGION=us-east-1

# Qdrant vector store — runs as the `qdrant` service in this compose stack.
# The collection is created on deploy by the `qdrant-init` one-shot service
# (see scripts/qdrant_init.py).
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=applyforge_chunks
# Must match your embedding model output dimension:
#   text-embedding-3-small / ada-002 → 1536
#   text-embedding-3-large           → 3072
#   MockEmbeddingProvider (dev/test) → 16
EMBEDDING_DIM=1536

# ── Job Crawler (Pro feature) ─────────────────────────────────────────────
# Adzuna API (optional — adds Adzuna as a job source; free signup at developer.adzuna.com)
# ADZUNA_APP_ID=your_app_id
# ADZUNA_APP_KEY=your_app_key
